include("lib/http.bzg");

var server = http(8000);

// ==============================
// HTTP EVENT HANDLERS
// ==============================
server.get = function (path, data) {
    print("get loc:" + path);
    if (path == "/") {
        server.sendFile("public/index.html");
    } else if (path == "/style.css") {
        server.sendFile("public/style.css");
    } else {
        server.sendFile("public/404.html");
    }
};

// ==============================
// WEBSOCKET (WS) EVENT HANDLERS
// ==============================

// Triggered when a client successfully connects
server.onConnect = function (clientId) {
    print("WebSocket connected! Client ID: " + clientId);
    // Tell the connecting client its ID (used by the browser for signaling)
    server.send(clientId, "__id__:" + clientId);
};

// Triggered when a client sends a message
server.onData = function (message, clientId) {
    print("Received from Client " + clientId + ": " + message);

    // Relay the raw message (JSON for chat / WebRTC signaling) to all clients.
    // Each browser ignores messages that are not addressed to it.
    server.sendAll(message);
};

// Triggered when a client disconnects
server.onDisconnect = function (clientId) {
    print("WebSocket disconnected! Client ID: " + clientId);
    // Let the remaining clients remove this participant's video tile
    server.sendAll("__left__:" + clientId);
};

// Start the server instance
server.run();